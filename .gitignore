__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# scraper output. The directory contents are ignored rather than the directory
# itself, because git will not descend into an excluded directory and the
# negation below would never be reached.
data/*
*.sqlite
*.sqlite3
# The price series is the one thing a rebuilt database cannot regenerate, so it
# is committed. Text, append-mostly, and it diffs.
!data/price-history.csv
# Same reasoning for the German study: it is a dated observation of a market,
# and re-running it next month measures next month rather than reproducing this.
# The workbook is left out — it is rebuilt from these two files.
!data/germany-pet-bib.csv
!data/germany-wine-all.csv
!data/germany-bib-price-matrix.csv
exports/
.cache/
http_cache/

.pytest_cache/
.coverage
.DS_Store

# node deps for tools/build_issue_brief.js (npm install docx)
node_modules/
package-lock.json
